<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="{{ description }}" />
    <title>{{ title }} | unstiff</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Noto+Sans+KR:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/site.css" />
  </head>
  <body>
    <main class="legal-page">
      {# App typography mapping: body-1-medium → text-t05 font-medium,
         caption-1-regular → text-t02 font-normal,
         body-3-medium → text-t03 font-medium. #}
      <header>
        <h1 class="text-t05 font-medium text-label-normal">{{ title }}</h1>
        <p class="mt-2 text-t02 text-label-disabled">v{{ version }} · {{ updatedAt }} 시행</p>
      </header>

      <article
        class="legal-document [&_ul]:mt-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mt-2 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:text-t02 [&_li]:font-normal [&_li]:text-label-disabled [&_li+li]:mt-1"
      >
        {{ content | safe }}
      </article>
    </main>
  </body>
</html>
