{
  "name": "unstiff-legal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./styles/input.css -o ./styles/site.css --minify",
    "dev": "npm run build:css && concurrently --kill-others --names css,site \"tailwindcss -i ./styles/input.css -o ./styles/site.css --watch\" \"eleventy --serve\"",
    "build": "npm run build:css && eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "concurrently": "9.2.4",
    "tailwindcss": "3.4.19",
    "wrangler": "^4.128.0"
  }
}
